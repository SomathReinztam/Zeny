DB_USER=postgres
DB_PASS=
DB_HOST=localhost
DB_PORT=5434
DB_NAME=zeny_agent_db
ZENY_LECTOR_PASS=

# LLM: openai_compat (vLLM en la EVO-X2) | gemini
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://10.8.0.82:8000/v1
LLM_API_KEY=EMPTY
MODEL_MAIN=qwen3-27b
MODEL_SQL=qwen3-27b
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Razonamiento: Zeny sí piensa (efecto visual); los analistas no, para aligerar la EVO
THINKING_MAIN=true
THINKING_SQL=false

LOG_LEVEL=INFO

# ─── Observabilidad: Langfuse (infra/langfuse.yml) ─────────────────────────────
# En Docker el compose fija LANGFUSE_HOST a http://host.docker.internal:3010.
LANGFUSE_HOST=http://localhost:3010
# Se llenan tras crear el proyecto en la UI de Langfuse (http://localhost:3010).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─── Secretos de la pila Langfuse (los usa infra/langfuse.yml) ─────────────────
# Contraseña del rol `langfuse` en zeny-db (db/langfuse_init.sql + DATABASE_URL).
LANGFUSE_DB_PASS=
# ENCRYPTION_KEY: openssl rand -hex 32   |   SALT / NEXTAUTH_SECRET: openssl rand -base64 32
ENCRYPTION_KEY=
SALT=
NEXTAUTH_SECRET=
# Credenciales internas de clickhouse y redis de la pila Langfuse.
CLICKHOUSE_PASSWORD=
REDIS_AUTH=

# ─── Frontend (horneado en el build del contenedor) ───────────────────────────
# Para tablets, apúntalo a la IP del host: http://IP_DEL_HOST:8100/agui
NEXT_PUBLIC_AGUI_URL=http://localhost:8100/agui
