data: {"type":"STATE_SNAPSHOT","snapshot":{"charts":{"900ce0ad":{"id":"900ce0ad","titulo":"Energía exportada por hora y día - Septiembre 2026","subtitulo":null,"tipo":"mapa_calor","insight":"Patrón claro de producción solar entre 5:00 y 18:00 con pico sostenido a las 11:00-13:00 (hasta >1.000 kWh/h). Resaltan días sin exportación (23 y 24 de septiembre) a pesar de buen sol.","severidad":"alerta","autor":"zeny","creado_en":"2026-10-16T10:51:46","sql":"SELECT \n    to_char(hora AT TIME ZONE 'America/Bogota', 'YYYY-MM-DD') AS dia,\n    to_char(hora AT TIME ZONE 'America/Bogota', 'HH24:00') AS hora,\n    round(COALESCE(kwh_frontera, 0)::numeric, 2) AS kwh_exportado\nFROM analitica.v_energia_horaria\nWHERE hora >= '2026-09-01 00:00:00-05' AND hora < '2026-10-01 00:00:00-05'\n  AND EXTRACT(HOUR FROM hora AT TIME ZONE 'America/Bogota') BETWEEN 5 AND 18\nORDER BY hora AT TIME ZONE 'America/Bogota' ASC;","x":"dia","x_es_tiempo":false,"series":[],"datos":[{"dia":"2026-09-01","hora":"05:00","kwh_exportado":0.0},{"dia":"2026-09-01","hora":"06:00","kwh_exportado":0.0},{"dia":"2026-09-01","hora":"07:00","kwh_exportado":212.52},{"dia":"2026-09-01","hora":"08:00","kwh_exportado":455.06},{"dia":"2026-09-01","hora":"09:00","kwh_exportado":905.86},{"dia":"2026-09-01","hora":"10:00","kwh_exportado":872.16},{"dia":"2026-09-01","hora":"11:00","kwh_exportado":919.77},{"dia":"2026-09-01","hora":"12:00","kwh_exportado":991.99},{"dia":"2026-09-01","hora":"13:00","kwh_exportado":671.03},{"dia":"2026-09-01","hora":"14:00","kwh_exportado":391.0},{"dia":"2026-09-01","hora":"15:00","kwh_exportado":37.61},{"dia":"2026-09-01","hora":"16:00","kwh_exportado":0.0},{"dia":"2026-09-01","hora":"17:00","kwh_exportado":0.0},{"dia":"2026-09-01","hora":"18:00","kwh_exportado":0.0},{"dia":"2026-09-02","hora":"05:00","kwh_exportado":0.0},{"dia":"2026-09-02","hora":"06:00","kwh_exportado":0.0},{"dia":"2026-09-02","hora":"07:00","kwh_exportado":467.13},{"dia":"2026-09-02","hora":"08:00","kwh_exportado":538.78},{