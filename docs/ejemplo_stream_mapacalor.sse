data: {"type":"CUSTOM","subagentRunId":"tools:e7ad59da-1d80-c884-cc72-01cf9a3c7295","name":"zeny_sql","value":{"sql":"SELECT \n    to_char(hora, 'HH24:00') AS hora_del_dia,\n    round(avg(kwh_frontera)::numeric, 1) AS kwh_promedio,\n    round(max(kwh_frontera)::numeric, 1) AS kwh_maximo\nFROM analitica.v_energia_horaria\nWHERE hora >= '2026-09-01' AND hora < '2026-10-01'\nGROUP BY hora_del_dia, EXTRACT(HOUR FROM hora)\nORDER BY EXTRACT(HOUR FROM hora);"}}

