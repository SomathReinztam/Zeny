data: {"type":"CUSTOM","subagentRunId":"tools:e7ad59da-1d80-c884-cc72-01cf9a3c7295","name":"zeny_sql","value":{"sql":"SELECT \n    to_char(hora, 'YYYY-MM-DD') AS dia,\n    to_char(hora, 'HH24:00') AS hora,\n    round(COALESCE(kwh_frontera, 0)::numeric, 2) AS kwh_exportado\nFROM analitica.v_energia_horaria\nWHERE hora >= '2026-09-01' AND hora < '2026-10-01'\nORDER BY hora ASC\nLIMIT 10;"}}

