data: {"type":"CUSTOM","subagentRunId":"tools:e7ad59da-1d80-c884-cc72-01cf9a3c7295","name":"zeny_sql","value":{"sql":"SELECT \n    dia, kwh_frontera, poa_kwh_m2, clasificacion\nFROM analitica.v_energia_diaria\nORDER BY kwh_frontera DESC\nLIMIT 5;"}}

