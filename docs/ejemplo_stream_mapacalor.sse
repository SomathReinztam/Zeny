data: {"type":"CUSTOM","subagentRunId":"tools:e7ad59da-1d80-c884-cc72-01cf9a3c7295","name":"zeny_sql","value":{"sql":"SELECT \n    dia, kwh_frontera, poa_kwh_m2, clasificacion\nFROM analitica.v_energia_diaria\nWHERE kwh_frontera IS NOT NULL\nORDER BY kwh_frontera ASC\nLIMIT 5;"}}

data: {"type":"TOOL_CALL_RESULT","subagentRunId":"tools:e7ad59da-1d80-c884-cc72-01cf9a3c7295","messageId":"call_1312008","toolCallId":"call_1312008","content":"5 filas:\ndia | kwh_frontera | poa_kwh_m2 | clasificacion\n2026-09-23 | 0 | 7.745 | posible_falla\n2026-09-24 | 0 | 6.889 | posible_falla\n2026-09-18 | 48.07 | 8.263 | posible_falla\n2026-09-27 | 1132 | 3.892 | posible_falla\n2026-09-19 | 2993 | 4.775 | normal","role":"tool"}

