data: {"type":"CUSTOM","subagentRunId":"tools:e7ad59da-1d80-c884-cc72-01cf9a3c7295","name":"zeny_sql","value":{"sql":"SELECT \n    min(EXTRACT(HOUR FROM hora AT TIME ZONE 'America/Bogota')) AS min_hora_con_sol,\n    max(EXTRACT(HOUR FROM hora AT TIME ZONE 'America/Bogota')) AS max_hora_con_sol\nFROM analitica.v_energia_horaria\nWHERE kwh_frontera > 0;"}}

